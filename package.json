{
  "name": "akar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @akar/web",
    "dev:api": "bash services/api/scripts/web-api.sh",
    "dev:content": "node apps/web/scripts/prepare-demo-content.mjs && NEXT_PUBLIC_DEMO_CONTENT=1 npm run dev -w @akar/web",
    "api": "npm run local -w @akar/api",
    "api:token": "npm run -s local:token -w @akar/api --",
    "build": "npm run build -w @akar/web",
    "start": "npm run start -w @akar/web",
    "typecheck": "npm run typecheck -w @akar/web",
    "test": "node --import tsx --test packages/domain/src/*.test.ts packages/api-client/src/*.test.ts apps/web/src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test -c services/api/e2e",
    "check": "bash scripts/check.sh",
    "format": "prettier --write apps/web/src packages docs tests"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
