DATABASE_URL=postgres://akar:akar@127.0.0.1:5433/akar
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
# Reverse proxies in front of the API (hop count). 0 locally; 1 behind a single load balancer.
TRUST_PROXY=0
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact address sent to Nominatim (usage policy); optional.
NOMINATIM_EMAIL=
# Overpass API for the bulk OSM match in `npm run ingest`; optional.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Supabase: local stack (`supabase start`, values from `supabase status -o env`) or the cloud project
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
AUTH_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
AUTH_JWT_AUDIENCE=authenticated

# Object storage: s3 (Supabase Storage S3 protocol) or fs (local folder, one subfolder per bucket)
STORAGE_DRIVER=s3
STORAGE_FS_ROOT=
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=local
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Clients upload into the non-public STORAGE_UPLOAD_BUCKET; complete copies checked files into the public STORAGE_BUCKET.
STORAGE_BUCKET=media
STORAGE_UPLOAD_BUCKET=uploads
# Quota (MB) the admin health warning measures stored media against; 1024 = Supabase Free. Optional.
STORAGE_QUOTA_MB=1024
# Must serve the STORAGE_BUCKET bucket, not the upload one.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/media
# AI voice-over and translation of site texts (decision 11.56). All optional: without a key the endpoints answer 503.
# DEEPGRAM_API_KEY=
# TTS_VOICES=tr.female=flux-dilek-tr,tr.male=flux-mehmet-tr,en.female=flux-sienna-en,en.male=flux-cliff-en
# TTS_DAILY_CHAR_LIMIT=100000
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Guest receipt HMAC key, at least 32 characters: openssl rand -base64 48
RECEIPT_SECRET=
VISIT_RADIUS_M=30

# Vercel: API_RUNTIME=vercel; DATABASE_URL uses the transaction pooler (6543).
API_RUNTIME=server
DATABASE_POOL_MAX=2
# Migration-only connection (session pooler 5432); do not add to Vercel.
DIRECT_DATABASE_URL=
# Supabase Cron shared secret; required in Vercel production, at least 32 characters.
# Omit locally if not calling the maintenance endpoint.
# JOB_SECRET=

# Supabase cloud: PEM contents of the CA downloaded from Database Settings.
# DATABASE_SSL_CA=
